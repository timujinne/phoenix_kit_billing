  <div class="container mx-auto px-4 py-6">
    <%!-- Header --%>
    <.admin_page_header back={PhoenixKit.Utils.Routes.path("/admin/billing/invoices")}>
      <div class="flex items-center gap-3">
        <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold font-mono text-base-content">
          {@invoice.invoice_number}
        </h1>
        <.invoice_status_badge status={@invoice.status} size={:md} />
        <.trash_badge :if={Invoice.trashed?(@invoice)} id="invoice-trashed-badge" size={:md} />
      </div>
      <p class="text-sm text-base-content/60 mt-0.5">
        {gettext("Created")} <.time_ago datetime={@invoice.inserted_at} />
      </p>
      <:actions>
        <%= if Invoice.trashed?(@invoice) do %>
          <button
            :if={@can_manage_invoices}
            id="restore-invoice-button"
            phx-click="open_restore_modal"
            class="btn btn-warning btn-sm"
          >
            <.icon name="hero-arrow-uturn-left" class="w-4 h-4" /> {gettext("Restore")}
          </button>
          <.link
            navigate={
              PhoenixKit.Utils.Routes.path("/admin/billing/invoices/#{@invoice.uuid}/print")
            }
            class="btn btn-outline btn-sm"
            target="_blank"
          >
            <.icon name="hero-printer" class="w-4 h-4" /> {gettext("Print / PDF")}
          </.link>
        <% else %>
          <%!-- Send/Resend Invoice - available for all except void --%>
          <%= if @invoice.status != "void" do %>
            <button phx-click="open_send_modal" class="btn btn-info btn-sm">
              <.icon name="hero-paper-airplane" class="w-4 h-4" />
              {if @invoice.status == "draft", do: gettext("Send Invoice"), else: gettext("Resend Invoice")}
            </button>
          <% end %>

          <%!-- Mark as Paid - available for sent/overdue --%>
          <%= if @invoice.status in ["sent", "overdue"] do %>
            <button phx-click="open_payment_modal" class="btn btn-success btn-sm">
              <.icon name="hero-banknotes" class="w-4 h-4" /> {gettext("Record Payment")}
            </button>
          <% end %>

          <%!-- Online Payment Providers - available for sent/overdue with remaining balance --%>
          <%= if @invoice.status in ["sent", "overdue"] && Decimal.positive?(PhoenixKitBilling.Invoice.remaining_amount(@invoice)) do %>
            <%= for provider <- @available_providers do %>
              <button
                phx-click="pay_with_provider"
                phx-value-provider={provider}
                class={[
                  "btn btn-sm",
                  provider == :stripe && "btn-primary",
                  provider == :paypal && "btn-info",
                  provider == :razorpay && "btn-secondary"
                ]}
                disabled={@checkout_loading != nil}
              >
                <%= if @checkout_loading == provider do %>
                  <span class="loading loading-spinner loading-xs"></span>
                <% else %>
                  <%= case provider do %>
                    <% :stripe -> %>
                      <.icon name="hero-credit-card" class="w-4 h-4" />
                    <% :paypal -> %>
                      <.icon name="hero-currency-dollar" class="w-4 h-4" />
                    <% :razorpay -> %>
                      <.icon name="hero-banknotes" class="w-4 h-4" />
                    <% _ -> %>
                      <.icon name="hero-credit-card" class="w-4 h-4" />
                  <% end %>
                <% end %>
                {gettext("Pay with %{provider}", provider: provider |> Atom.to_string() |> String.capitalize())}
              </button>
            <% end %>
          <% end %>

          <%!-- Issue Refund - available if has payments --%>
          <%= if PhoenixKitBilling.Invoice.has_payments?(@invoice) do %>
            <button phx-click="open_refund_modal" class="btn btn-warning btn-sm">
              <.icon name="hero-arrow-uturn-left" class="w-4 h-4" /> {gettext("Issue Refund")}
            </button>
          <% end %>

          <%!-- Generate Receipt - available when paid_amount > 0 and no receipt yet --%>
          <%= if is_nil(@invoice.receipt_number) && @invoice.paid_amount && Decimal.gt?(@invoice.paid_amount, Decimal.new(0)) do %>
            <button phx-click="generate_receipt" class="btn btn-outline btn-sm">
              <.icon name="hero-document-check" class="w-4 h-4" />
              <%= if @invoice.status == "paid" do %>
                {gettext("Generate Receipt")}
              <% else %>
                {gettext("Generate Partial Receipt")}
              <% end %>
            </button>
          <% end %>

          <%!-- Void - while the invoice is voidable and has no payments on it --%>
          <%= cond do %>
            <% Invoice.void_offered?(@invoice) -> %>
              <button
                id="void-invoice-button"
                phx-click="open_void_modal"
                class="btn btn-error btn-outline btn-sm"
              >
                <.icon name="hero-x-mark" class="w-4 h-4" /> {gettext("Void")}
              </button>
            <% Invoice.voidable?(@invoice) -> %>
              <span
                id="void-invoice-unavailable"
                class="text-xs text-base-content/60 self-center"
              >
                {gettext("Cannot be voided: it has payments. Refund them instead.")}
              </span>
            <% true -> %>
          <% end %>

          <.link
            navigate={
              PhoenixKit.Utils.Routes.path("/admin/billing/invoices/#{@invoice.uuid}/print")
            }
            class="btn btn-outline btn-sm"
            target="_blank"
          >
            <.icon name="hero-printer" class="w-4 h-4" /> {gettext("Print / PDF")}
          </.link>

          <%!-- View Receipt - available when receipt is generated --%>
          <%= if @invoice.receipt_number do %>
            <.link
              navigate={
                PhoenixKit.Utils.Routes.path("/admin/billing/invoices/#{@invoice.uuid}/receipt")
              }
              class="btn btn-success btn-sm"
              target="_blank"
            >
              <.icon name="hero-document-check" class="w-4 h-4" /> {gettext("View Receipt")}
            </.link>
            <button phx-click="open_send_receipt_modal" class="btn btn-success btn-outline btn-sm">
              <.icon name="hero-paper-airplane" class="w-4 h-4" /> {gettext("Send Receipt")}
            </button>
          <% end %>

          <%!-- Move to trash - a draft that was never sent; an issued invoice is voided --%>
          <%= if @can_manage_invoices and Invoice.trashable?(@invoice) do %>
            <button id="trash-invoice-button" phx-click="open_trash_modal" class="btn btn-outline btn-sm">
              <.icon name="hero-trash" class="w-4 h-4" /> {gettext("Move to trash")}
            </button>
          <% end %>
        <% end %>
      </:actions>
    </.admin_page_header>

    <%!-- An invoice in the trash says so, since when and by whom. --%>
    <.trash_notice
      :if={Invoice.trashed?(@invoice)}
      id="invoice-trashed-mark"
      trashed_at={@invoice.trashed_at}
      by={@trashed_by}
    />

    <%!-- A void invoice says so loudly; the reason is the trail void_invoice/3 left. --%>
    <%= if @invoice.status == "void" do %>
      <div id="invoice-void-mark" role="alert" class="alert alert-error alert-soft mb-6">
        <.icon name="hero-no-symbol" class="w-6 h-6" />
        <div>
          <h3 class="font-bold uppercase">{gettext("VOID")}</h3>
          <%= if @invoice.voided_at do %>
            <p class="text-sm">
              {gettext("Voided")} <.time_ago datetime={@invoice.voided_at} />
            </p>
          <% end %>
          <%= if reason = PhoenixKitBilling.Invoice.void_reason(@invoice) do %>
            <p id="invoice-void-reason" class="text-sm whitespace-pre-wrap">{reason}</p>
          <% end %>
        </div>
      </div>

      <%!-- A provider charge that arrived after the void is not on the ledger. --%>
      <%= if PhoenixKitBilling.Invoice.payments_after_void(@invoice) != [] do %>
        <div id="invoice-payments-after-void" role="alert" class="alert alert-warning mb-6">
          <.icon name="hero-exclamation-triangle" class="w-6 h-6" />
          <div>
            <h3 class="font-bold">
              {gettext("Payment received after void - refund it at the payment provider")}
            </h3>
            <ul class="text-sm">
              <%= for payment <- PhoenixKitBilling.Invoice.payments_after_void(@invoice) do %>
                <li>
                  {payment["provider"]} {payment["charge_id"]} - {payment["amount"]} {payment["currency"]}
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    <% end %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <%!-- Main Content --%>
      <div class="lg:col-span-2 space-y-6">
        <%!-- Invoice Details --%>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">{gettext("Invoice Details")}</h2>

            <%!-- Line Items --%>
            <div class="overflow-x-auto overflow-y-clip mt-4">
              <table class="table">
                <thead>
                  <tr>
                    <th>{gettext("Item")}</th>
                    <th class="text-right">{gettext("Qty")}</th>
                    <th class="text-right">{gettext("Unit Price")}</th>
                    <th class="text-right">{gettext("Total")}</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for item <- @invoice.line_items || [] do %>
                    <tr>
                      <td>
                        <div class="font-medium">{item["name"]}</div>
                        <%= if item["description"] do %>
                          <div class="text-sm text-base-content/60">{item["description"]}</div>
                        <% end %>
                      </td>
                      <td class="text-right">{item["quantity"]}</td>
                      <td class="text-right">
                        <.currency_compact
                          amount={item["unit_price"]}
                          currency={@invoice.currency}
                        />
                      </td>
                      <td class="text-right">
                        <.currency_compact amount={item["total"]} currency={@invoice.currency} />
                      </td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot>
                  <tr>
                    <td colspan="3" class="text-right font-medium">{gettext("Subtotal")}</td>
                    <td class="text-right">
                      <.currency_compact amount={@invoice.subtotal} currency={@invoice.currency} />
                    </td>
                  </tr>
                  <%= if Decimal.gt?(@invoice.tax_amount || Decimal.new(0), Decimal.new(0)) do %>
                    <tr>
                      <td colspan="3" class="text-right">
                        {gettext("Tax")} ({Decimal.round(
                          Decimal.mult(@invoice.tax_rate || Decimal.new(0), 100),
                          2
                        )
                        |> Decimal.normalize()
                        |> Decimal.to_string()}%)
                      </td>
                      <td class="text-right">
                        <.currency_compact
                          amount={@invoice.tax_amount}
                          currency={@invoice.currency}
                        />
                      </td>
                    </tr>
                  <% end %>
                  <tr class="text-lg font-bold">
                    <td colspan="3" class="text-right">{gettext("Total")}</td>
                    <td class="text-right">
                      <.currency_amount amount={@invoice.total} currency={@invoice.currency} />
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>

        <%!-- Payments & Transactions --%>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <div class="flex justify-between items-center">
              <h2 class="card-title">{gettext("Payments & Transactions")}</h2>
              <.link
                navigate={PhoenixKit.Utils.Routes.path("/admin/billing/transactions")}
                class="btn btn-ghost btn-xs"
              >
                {gettext("View All")} <.icon name="hero-arrow-right" class="w-3 h-3" />
              </.link>
            </div>

            <%!-- Payment Summary --%>
            <div class="grid grid-cols-3 gap-4 mt-4">
              <div class="bg-base-200 rounded-lg p-4 text-center">
                <div class="text-sm text-base-content/60">{gettext("Total")}</div>
                <div class="text-lg font-bold">
                  <.currency_compact amount={@invoice.total} currency={@invoice.currency} />
                </div>
              </div>
              <div class="bg-success/10 rounded-lg p-4 text-center">
                <div class="text-sm text-success">{gettext("Paid")}</div>
                <div class="text-lg font-bold text-success">
                  <.currency_compact amount={@invoice.paid_amount} currency={@invoice.currency} />
                </div>
              </div>
              <div class={[
                "rounded-lg p-4 text-center",
                if(
                  Decimal.positive?(
                    PhoenixKitBilling.Invoice.remaining_amount(@invoice)
                  ),
                  do: "bg-warning/10",
                  else: "bg-base-200"
                )
              ]}>
                <div class={[
                  "text-sm",
                  if(
                    Decimal.positive?(
                      PhoenixKitBilling.Invoice.remaining_amount(@invoice)
                    ),
                    do: "text-warning",
                    else: "text-base-content/60"
                  )
                ]}>
                  {gettext("Remaining")}
                </div>
                <div class={[
                  "text-lg font-bold",
                  if(
                    Decimal.positive?(
                      PhoenixKitBilling.Invoice.remaining_amount(@invoice)
                    ),
                    do: "text-warning",
                    else: "text-base-content/60"
                  )
                ]}>
                  <.currency_compact
                    amount={PhoenixKitBilling.Invoice.remaining_amount(@invoice)}
                    currency={@invoice.currency}
                  />
                </div>
              </div>
            </div>

            <%!-- Transactions Table --%>
            <%= if Enum.empty?(@transactions) do %>
              <div class="text-center py-6 text-base-content/50">
                <.icon name="hero-banknotes" class="w-8 h-8 mx-auto mb-2 opacity-50" />
                <p>{gettext("No transactions recorded yet")}</p>
              </div>
            <% else %>
              <.table_default size="sm" wrapper_class="mt-4 overflow-x-auto overflow-y-clip">
                <.table_default_header>
                  <.table_default_row>
                    <.table_default_header_cell>{gettext("Date")}</.table_default_header_cell>
                    <.table_default_header_cell>{gettext("Number")}</.table_default_header_cell>
                    <.table_default_header_cell>{gettext("Type")}</.table_default_header_cell>
                    <.table_default_header_cell class="text-right">
                      {gettext("Amount")}
                    </.table_default_header_cell>
                    <.table_default_header_cell>
                      {gettext("Description")}
                    </.table_default_header_cell>
                    <.table_default_header_cell class="text-right">
                      {gettext("Actions")}
                    </.table_default_header_cell>
                  </.table_default_row>
                </.table_default_header>
                <.table_default_body>
                  <%= for transaction <- @transactions do %>
                    <.table_default_row>
                      <.table_default_cell class="text-sm text-base-content/60">
                        <.time_ago datetime={transaction.inserted_at} />
                      </.table_default_cell>
                      <.table_default_cell class="font-mono text-xs">
                        {transaction.transaction_number}
                      </.table_default_cell>
                      <.table_default_cell>
                        <.transaction_type_badge type={
                          PhoenixKitBilling.Transaction.type(transaction)
                        } />
                      </.table_default_cell>
                      <.table_default_cell class="text-right">
                        <span class={[
                          "font-mono font-medium",
                          if(Decimal.positive?(transaction.amount),
                            do: "text-success",
                            else: "text-error"
                          )
                        ]}>
                          <%= if Decimal.positive?(transaction.amount) do %>
                            +<.currency_compact
                              amount={transaction.amount}
                              currency={transaction.currency}
                            />
                          <% else %>
                            <.currency_compact
                              amount={transaction.amount}
                              currency={transaction.currency}
                            />
                          <% end %>
                        </span>
                      </.table_default_cell>
                      <.table_default_cell class="max-w-[200px] truncate text-sm text-base-content/70">
                        {transaction.description || "-"}
                      </.table_default_cell>
                      <.table_default_cell class="text-right">
                        <.table_row_menu id={"transaction-menu-#{transaction.uuid}"}>
                          <%= if Decimal.negative?(transaction.amount) do %>
                            <%!-- Refund: Credit Note actions --%>
                            <.table_row_menu_link
                              navigate={
                                PhoenixKit.Utils.Routes.path(
                                  "/admin/billing/invoices/#{@invoice.uuid}/credit-note/#{transaction.uuid}"
                                )
                              }
                              target="_blank"
                              icon="hero-printer"
                              label={gettext("Print Credit Note")}
                              variant="warning"
                            />
                            <.table_row_menu_button
                              phx-click="open_send_credit_note_modal"
                              phx-value-transaction-uuid={transaction.uuid}
                              icon="hero-paper-airplane"
                              label={gettext("Send Credit Note")}
                              variant="warning"
                            />
                          <% else %>
                            <%!-- Payment: Payment Confirmation actions --%>
                            <.table_row_menu_link
                              navigate={
                                PhoenixKitBilling.Paths.payment_confirmation(
                                  @invoice.uuid,
                                  transaction.uuid
                                )
                              }
                              target="_blank"
                              icon="hero-printer"
                              label={gettext("Print Payment Confirmation")}
                              variant="success"
                            />
                            <.table_row_menu_button
                              phx-click="open_send_payment_confirmation_modal"
                              phx-value-transaction-uuid={transaction.uuid}
                              icon="hero-paper-airplane"
                              label={gettext("Send Payment Confirmation")}
                              variant="success"
                            />
                          <% end %>
                        </.table_row_menu>
                      </.table_default_cell>
                    </.table_default_row>
                  <% end %>
                </.table_default_body>
              </.table_default>
            <% end %>
          </div>
        </div>

        <%!-- Payment Terms & Notes --%>
        <%= if @invoice.payment_terms || @invoice.notes do %>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <h2 class="card-title">{gettext("Payment Information")}</h2>
              <%= if @invoice.payment_terms do %>
                <div class="mt-2">
                  <h4 class="font-medium text-sm text-base-content/60">{gettext("Payment Terms")}</h4>
                  <p class="mt-1">{@invoice.payment_terms}</p>
                </div>
              <% end %>
              <%= if @invoice.bank_details && map_size(@invoice.bank_details) > 0 do %>
                <div class="mt-4">
                  <h4 class="font-medium text-sm text-base-content/60">{gettext("Bank Details")}</h4>
                  <div class="mt-2 bg-base-200 p-4 rounded-lg font-mono text-sm">
                    <%= if @invoice.bank_details["bank_name"] do %>
                      <div>{gettext("Bank:")} {@invoice.bank_details["bank_name"]}</div>
                    <% end %>
                    <%= if @invoice.bank_details["account_name"] do %>
                      <div>{gettext("Account:")} {@invoice.bank_details["account_name"]}</div>
                    <% end %>
                    <%= if @invoice.bank_details["iban"] do %>
                      <div>{gettext("IBAN:")} {@invoice.bank_details["iban"]}</div>
                    <% end %>
                    <%= if @invoice.bank_details["swift"] do %>
                      <div>{gettext("SWIFT/BIC:")} {@invoice.bank_details["swift"]}</div>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <%= if @invoice.notes do %>
                <div class="mt-4">
                  <h4 class="font-medium text-sm text-base-content/60">{gettext("Notes")}</h4>
                  <p class="mt-1">{@invoice.notes}</p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%!-- Receipt --%>
        <%= if @invoice.receipt_number do %>
          <div class="card bg-success/10 border border-success shadow-xl">
            <div class="card-body">
              <div class="flex items-center gap-3">
                <.icon name="hero-document-check" class="w-8 h-8 text-success" />
                <div>
                  <h2 class="card-title text-success">{gettext("Receipt Generated")}</h2>
                  <p class="font-mono">{@invoice.receipt_number}</p>
                  <p class="text-sm text-base-content/60 mt-1">
                    {gettext("Generated")} <.time_ago datetime={@invoice.receipt_generated_at} />
                  </p>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <%!-- Sidebar --%>
      <div class="space-y-6">
        <%!-- Related Order --%>
        <%= if @invoice.order do %>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <h2 class="card-title">{gettext("Related Order")}</h2>
              <div class="mt-2">
                <.link
                  navigate={
                    PhoenixKit.Utils.Routes.path("/admin/billing/orders/#{@invoice.order.uuid}")
                  }
                  class="flex items-center gap-3 p-3 bg-base-200 rounded-lg hover:bg-base-300 transition-colors"
                >
                  <.icon name="hero-clipboard-document-list" class="w-6 h-6 text-primary" />
                  <div>
                    <div class="font-mono font-medium">{@invoice.order.order_number}</div>
                    <div class="text-sm text-base-content/60">
                      <.order_status_badge status={@invoice.order.status} size={:xs} />
                    </div>
                  </div>
                </.link>
              </div>
            </div>
          </div>
        <% end %>

        <%!-- Customer Info --%>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">{gettext("Customer")}</h2>
            <%= if @invoice.user do %>
              <div class="flex items-center gap-3 mt-2">
                <.user_avatar user={@invoice.user} size="lg" />
                <div>
                  <div class="font-medium">{@invoice.user.email}</div>
                  <.link
                    navigate={
                      PhoenixKit.Utils.Routes.path("/admin/users/edit/#{@invoice.user.uuid}")
                    }
                    class="text-sm text-primary hover:underline"
                  >
                    {gettext("View Profile")}
                  </.link>
                </div>
              </div>
            <% else %>
              <%= if payer = PhoenixKitBilling.Invoice.payer_email(@invoice.billing_details) do %>
                <div class="mt-2">
                  <div class="font-medium">{payer}</div>
                  <div class="text-sm text-base-content/60">
                    {gettext("Guest payer — no account")}
                  </div>
                </div>
              <% else %>
                <p class="text-base-content/50 mt-2">{gettext("No customer linked")}</p>
              <% end %>
            <% end %>
          </div>
        </div>

        <%!-- Billing Details --%>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">{gettext("Billing Details")}</h2>
            <%= if @invoice.billing_details && map_size(@invoice.billing_details) > 0 do %>
              <div class="mt-2 space-y-2 text-sm">
                <%= if @invoice.billing_details["type"] == "company" do %>
                  <div class="font-medium">{@invoice.billing_details["company_name"]}</div>
                  <%= if @invoice.billing_details["company_vat_number"] do %>
                    <div class="text-base-content/60">
                      {gettext("VAT:")} {@invoice.billing_details["company_vat_number"]}
                    </div>
                  <% end %>
                <% else %>
                  <div class="font-medium">
                    {@invoice.billing_details["first_name"]} {@invoice.billing_details[
                      "last_name"
                    ]}
                  </div>
                <% end %>
                <%= if @invoice.billing_details["address_line1"] do %>
                  <div class="text-base-content/60">
                    {@invoice.billing_details["address_line1"]}<br />
                    <%= if @invoice.billing_details["address_line2"] do %>
                      {@invoice.billing_details["address_line2"]}<br />
                    <% end %>
                    {@invoice.billing_details["city"]}, {@invoice.billing_details["postal_code"]}<br />
                    {@invoice.billing_details["country"]}
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-base-content/50 mt-2">{gettext("No billing details")}</p>
            <% end %>
          </div>
        </div>

        <%!-- Timeline (sorted by datetime) --%>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">{gettext("Timeline")}</h2>
            <% timeline_events = build_timeline_events(@invoice, @transactions) %>
            <ul class="timeline timeline-vertical mt-2">
              <%= for {event, index} <- Enum.with_index(timeline_events) do %>
                <li>
                  <%= if index > 0 do %>
                    <hr />
                  <% end %>
                  <%= case event.type do %>
                    <% :created -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle">
                        <.icon name="hero-document-plus" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box">{gettext("Created")}</div>
                    <% :invoice_sent -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle text-info">
                        <.icon name="hero-paper-airplane" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box">
                        <div>{gettext("Invoice Sent")}</div>
                        <div class="text-xs text-base-content/60">{event.data["email"]}</div>
                      </div>
                    <% :invoice_sent_legacy -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle text-info">
                        <.icon name="hero-paper-airplane" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box">{gettext("Invoice Sent")}</div>
                    <% :payment -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle text-success">
                        <.icon name="hero-banknotes" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box bg-success/10 border-success">
                        <div>{gettext("Payment")}</div>
                        <div class="text-xs font-mono">
                          +<.currency_compact
                            amount={event.data.amount}
                            currency={event.data.currency}
                          />
                        </div>
                        <%= if event.data.description do %>
                          <div class="text-xs text-base-content/60">{event.data.description}</div>
                        <% end %>
                      </div>
                    <% :paid -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle text-success">
                        <.icon name="hero-check-circle" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box bg-success/10 border-success">
                        {gettext("Fully Paid")}
                      </div>
                    <% :receipt_generated -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle text-success">
                        <.icon name="hero-document-check" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box">
                        <div>{gettext("Receipt Generated")}</div>
                        <div class="text-xs text-base-content/60 font-mono">{event.data}</div>
                      </div>
                    <% :receipt_sent -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle text-success">
                        <.icon name="hero-paper-airplane" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box">
                        <div>{gettext("Receipt Sent")}</div>
                        <div class="text-xs text-base-content/60">{event.data["email"]}</div>
                      </div>
                    <% :refund -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle text-warning">
                        <.icon name="hero-arrow-uturn-left" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box bg-warning/10 border-warning">
                        <div>{gettext("Refund")}</div>
                        <div class="text-xs font-mono">
                          <.currency_compact
                            amount={Decimal.abs(event.data.amount)}
                            currency={event.data.currency}
                          />
                        </div>
                        <%= if event.data.description do %>
                          <div class="text-xs text-base-content/60">{event.data.description}</div>
                        <% end %>
                      </div>
                    <% :credit_note_sent -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle text-warning">
                        <.icon name="hero-paper-airplane" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box">
                        <div>{gettext("Credit Note Sent")}</div>
                        <div class="text-xs text-base-content/60">{event.data["email"]}</div>
                        <div class="text-xs text-base-content/60 font-mono">
                          {event.data["credit_note_number"]}
                        </div>
                      </div>
                    <% :voided -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle text-error">
                        <.icon name="hero-x-circle" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box bg-error/10 border-error">{gettext("Voided")}</div>
                    <% _ -> %>
                      <div class="timeline-start text-sm text-base-content/60">
                        <.time_ago datetime={event.datetime} />
                      </div>
                      <div class="timeline-middle">
                        <.icon name="hero-question-mark-circle" class="w-4 h-4" />
                      </div>
                      <div class="timeline-end timeline-box">{gettext("Unknown Event")}</div>
                  <% end %>
                  <%= if index < length(timeline_events) - 1 do %>
                    <hr />
                  <% end %>
                </li>
              <% end %>
              <%!-- Full refund indicator (always at the end if applicable) --%>
              <%= if fully_refunded?(@invoice, @transactions) do %>
                <li>
                  <hr />
                  <div class="timeline-start text-sm text-base-content/60"></div>
                  <div class="timeline-middle text-error">
                    <.icon name="hero-x-circle" class="w-4 h-4" />
                  </div>
                  <div class="timeline-end timeline-box bg-error/10 border-error">
                    <div>{gettext("Fully Refunded")}</div>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%!-- Payment Modal --%>
  <%= if @show_payment_modal do %>
    <div class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold text-lg">{gettext("Record Payment")}</h3>
        <p class="py-2 text-base-content/60">
          {gettext("Recording payment for invoice %{number}", number: @invoice.invoice_number)}
        </p>

        <form phx-change="update_payment_form" phx-submit="record_payment">
          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Amount")} ({@invoice.currency})</span>
              <span class="fieldset-label">
                {gettext("Remaining:")}
                <.currency_compact
                  amount={PhoenixKitBilling.Invoice.remaining_amount(@invoice)}
                  currency={@invoice.currency}
                />
              </span>
            </label>
            <.decimal_input
              id="payment-amount"
              name="amount"
              value={@payment_amount}
              required
            />
          </div>

          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Payment Method")}</span>
            </label>
            <select name="payment_method" class="select">
              <%= for method <- @available_payment_methods do %>
                <option value={method} selected={method == @selected_payment_method}>
                  {format_payment_method_name(method)}
                </option>
              <% end %>
            </select>
          </div>

          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Description (optional)")}</span>
            </label>
            <input
              type="text"
              name="description"
              value={@payment_description}
              placeholder={gettext("Payment reference, notes...")}
              class="input"
            />
          </div>

          <div class="modal-action">
            <button type="button" phx-click="close_payment_modal" class="btn">{gettext("Cancel")}</button>
            <button type="submit" class="btn btn-success">
              <.icon name="hero-banknotes" class="w-4 h-4" /> {gettext("Record Payment")}
            </button>
          </div>
        </form>
      </div>
      <div class="modal-backdrop" phx-click="close_payment_modal"></div>
    </div>
  <% end %>

  <%!-- Refund Modal --%>
  <%= if @show_refund_modal do %>
    <div class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold text-lg">{gettext("Issue Refund")}</h3>
        <p class="py-2 text-base-content/60">
          {gettext("Issue refund for invoice %{number}", number: @invoice.invoice_number)}
        </p>

        <form phx-change="update_refund_form" phx-submit="record_refund">
          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Refund Amount")} ({@invoice.currency})</span>
              <span class="fieldset-label">
                {gettext("Max:")}
                <.currency_compact
                  amount={@invoice.paid_amount}
                  currency={@invoice.currency}
                />
              </span>
            </label>
            <.decimal_input
              id="refund-amount"
              name="amount"
              value={@refund_amount}
              placeholder={gettext("Enter refund amount")}
              required
            />
          </div>

          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Reason")} <span class="text-error">*</span></span>
            </label>
            <input
              type="text"
              name="description"
              value={@refund_description}
              placeholder={gettext("Reason for refund (required)")}
              class="input"
              required
            />
          </div>

          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Refund Method")}</span>
            </label>
            <select name="payment_method" class="select">
              <%= for method <- @available_payment_methods do %>
                <option value={method} selected={method == @selected_refund_payment_method}>
                  {format_payment_method_name(method)}
                </option>
              <% end %>
            </select>
          </div>

          <div class="modal-action">
            <button type="button" phx-click="close_refund_modal" class="btn">{gettext("Cancel")}</button>
            <button type="submit" class="btn btn-warning">
              <.icon name="hero-arrow-uturn-left" class="w-4 h-4" /> {gettext("Issue Refund")}
            </button>
          </div>
        </form>
      </div>
      <div class="modal-backdrop" phx-click="close_refund_modal"></div>
    </div>
  <% end %>

  <%!-- Void Invoice Modal --%>
  <%= if @show_void_modal do %>
    <div id="void-invoice-modal" class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold text-lg">{gettext("Void Invoice")}</h3>
        <p class="py-2 text-base-content/60">
          {gettext("Void invoice %{number}? This cannot be undone.", number: @invoice.invoice_number)}
        </p>

        <form id="void-invoice-form" phx-submit="void_invoice">
          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Reason (optional)")}</span>
            </label>
            <textarea
              name="reason"
              rows="3"
              maxlength={PhoenixKitBilling.reason_max_length()}
              class="textarea w-full"
              placeholder={gettext("Why is this invoice being voided?")}
            ></textarea>
          </div>

          <div class="modal-action">
            <button type="button" phx-click="close_void_modal" class="btn">{gettext("Cancel")}</button>
            <button type="submit" class="btn btn-error">
              <.icon name="hero-x-mark" class="w-4 h-4" /> {gettext("Void")}
            </button>
          </div>
        </form>
      </div>
      <div class="modal-backdrop" phx-click="close_void_modal"></div>
    </div>
  <% end %>

  <%!-- Send Invoice Modal --%>
  <%= if @show_send_modal do %>
    <div class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold text-lg">
          {if @invoice.status == "draft", do: gettext("Send Invoice"), else: gettext("Resend Invoice")}
        </h3>
        <p class="py-2 text-base-content/60">
          {if @invoice.status == "draft",
            do: gettext("Send invoice to customer's email address"),
            else: gettext("Resend invoice to customer's email address")}
        </p>

        <form phx-change="update_send_form" phx-submit="send_invoice">
          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Email Address")}</span>
            </label>
            <input
              type="email"
              name="email"
              value={@send_email}
              placeholder="customer@example.com"
              class="input"
              required
            />
          </div>

          <div class="modal-action">
            <button type="button" phx-click="close_send_modal" class="btn">{gettext("Cancel")}</button>
            <button type="submit" class="btn btn-info">
              <.icon name="hero-paper-airplane" class="w-4 h-4" />
              {if @invoice.status == "draft", do: gettext("Send Invoice"), else: gettext("Resend Invoice")}
            </button>
          </div>
        </form>
      </div>
      <div class="modal-backdrop" phx-click="close_send_modal"></div>
    </div>
  <% end %>

  <%!-- Send Receipt Modal --%>
  <%= if @show_send_receipt_modal do %>
    <div class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold text-lg">{gettext("Send Receipt")}</h3>
        <p class="py-2 text-base-content/60">
          {gettext("Send payment receipt to customer's email address")}
        </p>

        <form phx-change="update_send_receipt_form" phx-submit="send_receipt">
          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Email Address")}</span>
            </label>
            <input
              type="email"
              name="email"
              value={@send_receipt_email}
              placeholder="customer@example.com"
              class="input"
              required
            />
          </div>

          <div class="modal-action">
            <button type="button" phx-click="close_send_receipt_modal" class="btn">{gettext("Cancel")}</button>
            <button type="submit" class="btn btn-success">
              <.icon name="hero-paper-airplane" class="w-4 h-4" /> {gettext("Send Receipt")}
            </button>
          </div>
        </form>
      </div>
      <div class="modal-backdrop" phx-click="close_send_receipt_modal"></div>
    </div>
  <% end %>

  <%!-- Send Credit Note Modal --%>
  <%= if @show_send_credit_note_modal do %>
    <div class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold text-lg">{gettext("Send Credit Note")}</h3>
        <p class="py-2 text-base-content/60">
          {gettext("Send credit note (refund document) to customer's email address")}
        </p>

        <form phx-change="update_send_credit_note_form" phx-submit="send_credit_note">
          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Email Address")}</span>
            </label>
            <input
              type="email"
              name="email"
              value={@send_credit_note_email}
              placeholder="customer@example.com"
              class="input"
              required
            />
          </div>

          <div class="modal-action">
            <button type="button" phx-click="close_send_credit_note_modal" class="btn">
              {gettext("Cancel")}
            </button>
            <button type="submit" class="btn btn-warning">
              <.icon name="hero-paper-airplane" class="w-4 h-4" /> {gettext("Send Credit Note")}
            </button>
          </div>
        </form>
      </div>
      <div class="modal-backdrop" phx-click="close_send_credit_note_modal"></div>
    </div>
  <% end %>

  <%!-- Send Payment Confirmation Modal --%>
  <%= if @show_send_payment_confirmation_modal do %>
    <div class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold text-lg">{gettext("Send Payment Confirmation")}</h3>
        <p class="py-2 text-base-content/60">
          {gettext("Send payment confirmation to customer's email address")}
        </p>

        <form
          phx-change="update_send_payment_confirmation_form"
          phx-submit="send_payment_confirmation"
        >
          <div class="fieldset mt-4">
            <label class="label">
              <span class="fieldset-legend">{gettext("Email Address")}</span>
            </label>
            <input
              type="email"
              name="email"
              value={@send_payment_confirmation_email}
              placeholder="customer@example.com"
              class="input"
              required
            />
          </div>

          <div class="modal-action">
            <button type="button" phx-click="close_send_payment_confirmation_modal" class="btn">
              {gettext("Cancel")}
            </button>
            <button type="submit" class="btn btn-success">
              <.icon name="hero-paper-airplane" class="w-4 h-4" /> {gettext("Send Confirmation")}
            </button>
          </div>
        </form>
      </div>
      <div class="modal-backdrop" phx-click="close_send_payment_confirmation_modal"></div>
    </div>
  <% end %>


  <%!-- Move to Trash Modal --%>
  <%= if @show_trash_modal do %>
    <div id="trash-invoice-modal" class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold text-lg">{gettext("Move to trash")}</h3>
        <p class="py-2 text-base-content/60">
          {gettext("Move invoice %{number} to the trash?", number: @invoice.invoice_number)}
        </p>
        <p class="text-sm text-base-content/60">
          {gettext(
            "Nothing is deleted. The invoice number stays used and is never given to another invoice. Only a draft that was never sent can be moved to the trash; to cancel an issued invoice, void it instead."
          )}
        </p>

        <form id="trash-invoice-form" phx-submit="trash_invoice">
          <div class="modal-action">
            <button type="button" phx-click="close_trash_modal" class="btn">
              {gettext("Back")}
            </button>
            <button type="submit" class="btn btn-warning">
              <.icon name="hero-trash" class="w-4 h-4" /> {gettext("Move to trash")}
            </button>
          </div>
        </form>
      </div>
      <div class="modal-backdrop" phx-click="close_trash_modal"></div>
    </div>
  <% end %>

  <%!-- Restore Modal --%>
  <%= if @show_restore_modal do %>
    <div id="restore-invoice-modal" class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold text-lg">{gettext("Restore")}</h3>
        <p class="py-2 text-base-content/60">
          {gettext("Restore invoice %{number} from the trash?", number: @invoice.invoice_number)}
        </p>

        <form id="restore-invoice-form" phx-submit="restore_invoice">
          <div class="modal-action">
            <button type="button" phx-click="close_restore_modal" class="btn">
              {gettext("Back")}
            </button>
            <button type="submit" class="btn btn-warning">
              <.icon name="hero-arrow-uturn-left" class="w-4 h-4" /> {gettext("Restore")}
            </button>
          </div>
        </form>
      </div>
      <div class="modal-backdrop" phx-click="close_restore_modal"></div>
    </div>
  <% end %>
